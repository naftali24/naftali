(function($){'use strict';$(document).ready(function(){$(document).on('click','.message-wrapper__info, .arrow_down',function(){$(this).closest('.message-wrapper').toggleClass('opened');var message_id=$(this).data('post');var user_id=$(this).data('user');$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_read_single_message','message_id':message_id,'user_id':user_id},success:function(response){}})});$('.plus-btn').on('click',function(){$('#add-avatar-modal').modal('show')})
$('#form-personal-area-edit').on('click',function(){$(this).addClass('d-none');$(this).siblings('.d-none').removeClass('d-none');$('#show-weight').addClass('d-none');$('#form-personal-area-save-weight').removeClass('d-none');$('#edit-weight').removeClass('d-none');var form=$(this).closest('form');form.find('.s-radio-group').find('.d-none').addClass('d-inline-block').removeClass('d-none');form.find('#gender').closest('.s-input-group').addClass('d-none');form.find('.profile-image-btn').removeClass('d-none');form.find('.b-b').addClass('border-bottom-custom');form.find('.password-wrapper .first').addClass('text-success');form.find('input').each(function(){$(this).removeAttr('readonly')});form.find('.datepicker').trigger('click')});$('#form-personal-area-cancel').on('click',function(){$(this).addClass('d-none');$(this).siblings().addClass('d-none');$(this).siblings('.d-none').first().removeClass('d-none');$('#show-weight').removeClass('d-none');$('#form-personal-area-save-weight').addClass('d-none');$('#edit-weight').addClass('d-none');var form=$(this).closest('form');form.find('.s-radio-group').find('.d-inline-block').removeClass('d-inline-block').addClass('d-none');form.find('#gender').closest('.s-input-group').removeClass('d-none');form.find('.profile-image-btn').addClass('d-none');form.find('.b-b').removeClass('border-bottom-custom');form.find('input').each(function(){$(this).attr('readonly','readonly');$(this).val($(this).data('val'));if($(this).val()===''){$("label[for='"+this.id+"']").removeClass("labelfocus")}});form.find('.datepicker').trigger('click')});$('#form-personal-area-save').on('click',function(e){$(this).addClass('d-none');$(this).siblings().addClass('d-none');$(this).siblings('.d-none').first().removeClass('d-none');var form=$('#form-personal-area');e.preventDefault();form.find('.s-radio-group').find('.d-inline-block').removeClass('d-inline-block').addClass('d-none');form.find('#gender').closest('.s-input-group').removeClass('d-none');form.find('.profile-image-btn').addClass('d-none');form.find('.b-b').removeClass('border-bottom-custom');form.find('input').each(function(){$(this).attr('readonly','readonly');if($(this).val()===''){$("label[for='"+this.id+"']").removeClass("labelfocus")}});$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_form_personal_details_submit','form':form.serialize()},success:function(response){console.log(response)}});form.find('.datepicker').trigger('click')});$('#form-choose-image-save').on('click',function(e){e.preventDefault();var form2=new FormData();var form=$('#form-profile-image');var selectedBabushka=form.find('input[type="radio"]:checked').data('val');var babushka_radio=0,selected_image,profile_image;if(selectedBabushka){console.log('is babushka');babushka_radio=1;selected_image=selectedBabushka;form2.append("action",'sogo_form_personal_details_submit');form2.append("profile_image",selected_image);form2.append("babushka_radio",babushka_radio);console.log(form2)}else{console.log('is profile image');babushka_radio=2;profile_image=form.find('#profile-image-file').val();if(profile_image.length>0){var reader=new FileReader();var input=$('#profile-image-file');reader.readAsDataURL(input[0].files[0]);console.log('bigger than 0');selected_image=input[0].files[0];form2.append(input.attr('name'),input[0].files[0]);form2.append("action",'sogo_form_personal_details_submit');form2.append("profile_image",selected_image);form2.append("babushka_radio",babushka_radio);$("[data-updated-image]").append("<span class='profile-image-file-loader d-block loader'></span>")}}
$.ajax({type:'POST',url:sogo.ajaxurl,cache:!1,contentType:!1,processData:!1,xhr:function(){var myXhr=$.ajaxSettings.xhr();return myXhr},data:form2,success:function(response){$('[data-updated-image]').find('img').attr('src',response);var form=$('#form-profile-image');form.find('input[type="radio"]:checked').removeAttr('checked');form.find('#profile-image-file').val('');$('.profile-image-file-wrapper label span').removeClass('d-none');$('.profile-image-file-wrapper label img').attr('src','').addClass('d-none');console.log('success');$('.profile-image-file-loader').remove()}})});$('#form-choose-image-cancel').on('click',function(){$('.profile-image-file-wrapper label span').removeClass('d-none');$('.profile-image-file-wrapper label img').attr('src','').addClass('d-none')});$('#profile-image-file').on('change',function(){var form=$('#form-profile-image');var selected_image=$(this).val();var file=$(this)[0].files[0];console.log(selected_image);console.log(file);readURL(this)});function readURL(input){if(input.files&&input.files[0]){var reader=new FileReader();reader.onload=function(e){$('#profile-image-img').removeClass('d-none').attr('src',e.target.result).siblings().addClass('d-none')};reader.readAsDataURL(input.files[0])}}})})(jQuery)