(function ($) {
    'use strict';
    $(document).ready(function () {
        // PLAY VIMEO
        jQuery('.js-play-video-site').on('click', function () {
            // alert(1);
            var url = jQuery(this).data('url');
            jQuery('#sogo_simple_iframe').attr('src', url);
        });

        /*jQuery('.js-play-video-site-new').on('click', function () {
            alert(1)
            var url = jQuery(this).data('url');
            // check if url is vimeo movie
            fetch(`https://vimeo.com/api/oembed.json?url=${url}`)
                .then(response => {
                    if (!response.ok) {
                        // Invalid URL
                        throw new Error('Invalid URL');
                    } else {
                        // valid URL
                        console.log(response);
                        // open modal and send url
                        jQuery('#myModal-1').modal('show')
                        jQuery('#sogo_simple_iframe').attr('src', url);
                    }
                })
                .catch(err => {
                    // Invalid URL
                    console.error(err);
                });
        });*/

        jQuery('.js-play-video').on('click', function () {
            // alert(1);
            var url = jQuery(this).data('url');
            var src = jQuery(url).attr('src');
            jQuery('#sogo_simple_iframe').attr('src', src);
        });


        //modal things
        //fires when modal opens
        $('#myModal-1').on('show.bs.modal', function (e) {

            var s = $("#sogo_simple_iframe")[0].src.includes('?') ? "&autoplay=1" : "?autoplay=1";


            $("#sogo_simple_iframe")[0].src += s;
        });

        //fires when modal closes
        $('#myModal-1').on('hidden.bs.modal', function (e) {
            var iframe_src = $("#sogo_simple_iframe")[0].src;
            var src = iframe_src.slice(0, -11);

            $("#sogo_simple_iframe")[0].src = src;
        });

    });
})(jQuery);

