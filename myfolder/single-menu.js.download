(function($){'use strict';$(document).ready(function(){$('.portion-wrapper').first().removeClass('d-none');$('#next-btn').on('click',function(){var a=$('.portion-wrapper');a.each(function(){if($(this).hasClass('d-none')){$(this).removeClass('d-none');if(!$(this).next().hasClass('d-none')){$('#next-btn').addClass('hidden');$('#next-btn').prev().removeClass('hidden');return!1}
return!1}})});$('.portion-wrapper select').on('change',function(){var mealType=$(this).attr('id');var portionDetaild=$(this).find('option:selected').text();var selectedDataAttr=$(this).data('portion');selectedDataAttr=selectedDataAttr.split('');var splChars="*|,\":<>[]{}`\';()@&$#%";for(var i=0;i<selectedDataAttr.length;i++){if(splChars.indexOf(selectedDataAttr[i])!=-1){selectedDataAttr.splice(i,1)}}
var mealListing=$('.portions-final-wrapper').find('.portions-final-'+mealType);mealListing.removeClass('d-none');var newListing='<span class="d-block text-p color-3 mb-2" data-portion="'+selectedDataAttr+'">'+portionDetaild+'</span>';var span=mealListing.find('span[data-portion='+'\''+selectedDataAttr+'\''+']');console.log(span);if(span.length>0){span.text(portionDetaild)}else{mealListing.append(newListing)}})})})(jQuery)