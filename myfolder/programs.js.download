        /* Start Handle the One Time Code In Modal Verify Code*/
        let in1 = document.getElementById('otc-1'),
            ins = document.querySelectorAll('input[type="number"]');

        ins.forEach(function (input) {
            /**
             * Control on keyup to catch what the user intent to do.
             * I could have check for numeric key only here, but I didn't.
             */
            if (input) {
                input.addEventListener('keyup', function (e) {
                    // Break if Shift, Tab, CMD, Option, Control.
                    if (e.keyCode === 16 || e.keyCode == 9 || e.keyCode == 224 || e.keyCode == 18 || e.keyCode == 17) {
                        return;
                    }

                    // On Backspace or left arrow, go to the previous field.
                    if ((e.keyCode === 8 || e.keyCode === 37) && this.previousElementSibling && this.previousElementSibling.tagName === "INPUT") {
                        this.previousElementSibling.select();
                    } else if (e.keyCode !== 8 && this.nextElementSibling) {
                        this.nextElementSibling.select();
                    }
                });
            }


            /**
             * Better control on Focus
             * - don't allow focus on other field if the first one is empty
             * - don't allow focus on field if the previous one if empty (debatable)
             * - get the focus on the first empty field
             */
            if (input) {
                input.addEventListener('focus', function (e) {
                    // If the focus element is the first one, do nothing
                    if (this === in1) return;

                    // If value of input 1 is empty, focus it.
                    if (in1.value == '') {
                        in1.focus();
                    }

                    // If value of a previous input is empty, focus it.
                    // To remove if you don't wanna force user respecting the fields order.
                    if (this.previousElementSibling.value == '') {
                        this.previousElementSibling.focus();
                    }
                });
            }

        });

        /**
         * Handle copy/paste of a big number.
         * It catches the value pasted on the first field and spread it into the inputs.
         */
        /*in1.addEventListener('input', function(e) {
            if(e) {
                let data = e.data || this.value; // Chrome doesn't get the e.data, it's always empty, fallback to value then.

                if ( ! data ) return; // Shouldn't happen, just in case.
                if ( data.length === 1 ) return; // Here is a normal behavior, not a paste action.

                for (i = 0; i < data.length; i++ ) {
                    ins[i].value = data[i];

                }
            }

        });*/


        $('input[name=program-name]').on('change', function () {
            var val = $('input[name=program-name]:checked').val();

            let productId = $('#product_id_' + val).val();
            let productCat = $('#product_cat_' + val).val();
            let productCheckout = $('#checkout_url_' + val).val();

            var url = productCheckout + '?p_cat=' + productCat + '&add-to-cart=' + productId;
            localStorage.setItem('heli_payment_option_choose_url', url);

        })

    });

    $("#handleVerifyCode").on("click", function (event) {
        event.preventDefault();
        let otc1 = $('#otc-1').val();
        let otc2 = $('#otc-2').val();
        let otc3 = $('#otc-3').val();
        let otc4 = $('#otc-4').val();
        let otc5 = $('#otc-5').val();
        let tmepSmsCode = otc1 + otc2 + otc3 + otc4 + otc5

        var url = localStorage.getItem('heli_payment_option_choose_url');
        if (url) {
            localStorage.removeItem('heli_payment_option_choose_url');
            // if validation ok
            if (tmepSmsCode && tmepSmsCode.length === 5) {
                $('#handleVerifyCode').addClass('d-none');
                $('.bg-cover').removeClass('d-none');
                $('.loader').removeClass('d-none');
                $.ajax({
                    type: 'POST',
                    url: sogo.ajaxurl,
                    data: {
                        'action': 'heli_handle_login_via_sms',
                        'param': tmepSmsCode,
                        'type': 'tempCode',
                        'isPaymentOptionPage': true
                    },
                    success: function (response) {
                        if (response.data['isLoginSuccess']) {
                            iziToast.success({
                                title: 'התחברת בהצלחה, ',
                                message: '...',
                                position: 'center', // center
                                rtl: true
                            });
                            window.location.href = url;
                        } else {
                            iziToast.error({
                                title: 'שגיאה, ',
                                message: 'קוד זמני שגוי. נסה שנית',
                                position: 'center', // center
                                rtl: true
                            });

                            $('#handleVerifyCode').removeClass('d-none');
                            $('.bg-cover').addClass('d-none');
                            $('.loader').addClass('d-none');
                        }
                    }
                });
            } else {
                iziToast.error({
                    title: 'שגיאה, ',
                    message: 'מספר ספרות הקוד אינו תואם',
                });
            }
        } else {
            iziToast.error({
                title: 'שגיאה, ',
                message: 'לא נבחרה תוכנית, לא ניתן להמשיך.',
            });
        }


    });

    $(".handlePaymentMessageBtn").on("click", function (event) {
        event.preventDefault();
        $('.modal-payment-brn-wrapper').addClass('d-none');
        $('.bg-cover').removeClass('d-none');
        $('.loader').removeClass('d-none');
        $.ajax({
            type: 'POST',
            url: sogo.ajaxurl,
            data: {
                'action': 'handle_offline_user_payment',
                'offline_user': true,
            },
            success: function (response) {
                $('.bg-cover').addClass('d-none');
                $('.loader').addClass('d-none');
                if (response.data['isMoveToCheckOut']) {
                    window.location.href = response.data['redirect'];
                }

                $('.modal-payment-brn-wrapper').removeClass('d-none');
            }
        });

    });

    function moveToCheckout(checkoutUrl, productCategory, productId, product_cat, pageSource = '') {

        console.log("&&&&&&&&&&&&&&&&moveToCheckout");
        console.log(checkoutUrl);
        console.log(productCategory);
        console.log(productId);
        console.log(checkoutUrl && productCategory && productId);

        if (checkoutUrl && productCategory && productId) {
            let url = '';
            if (product_cat || pageSource) {
                let productCat = product_cat ? product_cat : pageSource
                url = checkoutUrl + '?p_cat=' + productCategory + '&add-to-cart=' + productId + '&sub_cat=' + productCat;
            } else {
                url = checkoutUrl + '?p_cat=' + productCategory + '&add-to-cart=' + productId;
            }

            console.log(url);

            window.location.href = url;
        }
    }

    function handleProgramsData(value) {
        $('.main-fetchers-box').find("*").removeClass("features-active");
        let url = '';
        let type = '';
        switch (value) {
            case 'combine' :
                $('.openPaymentModal_combine').removeClass('d-none');
                $('.openPaymentModal_online').addClass('d-none');
                $('.openGroupsModal').addClass('d-none');
                $('.combine-fetchers-box').addClass('features-active');
                url = '/groups/?plan_type=offline&sub_cat=combine';
                type = 'מנוי משולב';
                break;
            case 'offline':
                $('.openGroupsModal').removeClass('d-none');
                $('.openPaymentModal_online').addClass('d-none');
                $('.openPaymentModal_combine').addClass('d-none');
                $('.offline-fetchers-box').addClass('features-active');
                url = '/groups/?plan_type=offline';
                type = 'מנוי אופליין';
                break;
            case 'online':
                $('.openGroupsModal').addClass('d-none');
                $('.openPaymentModal_combine').addClass('d-none');
                $('.openPaymentModal_online').removeClass('d-none');
                $('.online-fetchers-box').addClass('features-active');
                url = '/payment-options/?plan_type=online';
                type = 'מנוי אונליין';
        }

        //localStorage.setItem('heli_program_selected_url', url);
        localStorage.setItem('heli_program_name_selected', value);

        return [
            {
                'url': url,
                'type': type
            }
        ]

    }

