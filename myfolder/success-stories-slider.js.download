(function($){'use strict';$(document).ready(function(){$('.js-success-stories-slider').slick({infinite:!1,rtl:!0,slidesToShow:3,slidesToScroll:1,draggable:!0,arrows:!0,nextArrow:'<i class="slick-arrow slick-next icon icon-arrowleft color-6 icon-x5"></i>',prevArrow:'<i class="slick-arrow slick-prev icon icon-arrowright color-6 icon-x5"></i>',dots:!1,centerPadding:'60px',responsive:[{breakpoint:992,settings:{slidesToShow:1,arrows:!1,centerMode:!0,centerPadding:'60px',}}]});if($(window).width()<1200){$('.slick-track').addClass('transform')}
var currentSlide=$('.js-success-stories-slider').slick('slickCurrentSlide');$('.slick-prev').toggle(currentSlide!==0);$('.slick-next').toggle(currentSlide!==2);$('.js-success-stories-slider').one('afterChange',function(){$(this).find('.slick-track').removeClass('transform');$(this).children().show()});$('.success-stories-box').on('click',function(){$(this).find('.substr-text').toggle('d-none');$(this).find('.full-text').toggle('d-block');$(this).find('.read-more').toggle('d-none');$(this).find('.read-less').toggle('d-block')})})})(jQuery)