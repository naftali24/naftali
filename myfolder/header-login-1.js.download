(function($){'use strict';$(document).ready(function(){$('.js-header-login-1-close-stripe').click(function(){var stripe=$('.header-login-1__stripe');var stripHeight=stripe.outerHeight()+'px';stripe.css('margin-top','-'+stripHeight);var headerHeight=$('.header-login-1').height();var stripeHeight=$('.header-login-1__stripe').outerHeight();$('#page').css({'padding-top':headerHeight-stripeHeight+'px'});if($('body').hasClass('mobile')){(function(){var headerHeight=$('.header-login-1 .container-fluid').height()+'px';$('.mobile .primary-menu').css({'top':headerHeight,'height':'calc(100vh - '+headerHeight+')'})})()}});(function(){var headerHeight=$('.header-login-1').height()+'px';$('#page').css('padding-top',headerHeight)})();if($('body').hasClass('mobile')){(function(){var headerHeight=$('.header-login-1').height()+'px';$('.primary-menu').css({'top':headerHeight,'height':'calc(100vh - '+headerHeight+')'})})()}})})(jQuery)