(function($){'use strict';$(document).ready(function(){$('.form-dashboard-mentor-edit').on('click',function(){$(this).addClass('d-none');$(this).siblings('.d-none').removeClass('d-none');var form=$(this).closest('form');form.find('.s-radio-group').find('.d-none').addClass('d-inline-block').removeClass('d-none');form.find('#gender').closest('.s-input-group').addClass('d-none');form.find('.profile-image-btn').removeClass('d-none');form.find('.b-b').addClass('border-bottom-custom');form.find('input').each(function(){$(this).removeAttr('readonly')});$('.mentor-edit-area').each(function(){$(this).find('.static-text').addClass('d-none');$(this).find('.edit-text').removeClass('d-none')})});$('.form-dashboard-mentor-cancel').on('click',function(){$(this).addClass('d-none');$(this).siblings().addClass('d-none');$(this).siblings('.d-none').first().removeClass('d-none');var form=$(this).closest('form');form.find('.profile-image-btn').addClass('d-none');$('.mentor-edit-area').each(function(){$(this).find('.static-text').removeClass('d-none');$(this).find('.edit-text').addClass('d-none');var currentText=$(this).find('.static-text').text();$(this).find('.input').val(currentText)})});$('#form-cube-3-dashboard-mentor-save').on('click',function(e){$(this).addClass('d-none');$(this).siblings().addClass('d-none');$(this).siblings('.d-none').first().removeClass('d-none');var form=$('#form-cube-3-dashboard-mentor');e.preventDefault();form.find('.profile-image-btn').addClass('d-none');$('.mentor-edit-area').each(function(){$(this).find('.static-text').removeClass('d-none');$(this).find('.edit-text').addClass('d-none')});$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_form_mentor_story_submit','form':form.serialize()},success:function(response){console.log(response);$('.mentor-edit-area').each(function(){var newText=$(this).find('.input').val();$(this).find('.static-text').text(newText)})}})});$('#form-cube-3-dashboard-mentor-choose-image-save').on('click',function(e){e.preventDefault();var form2=new FormData();var form=$('#form-mentor-image');var selected_image,profile_1_image;console.log('is mentor image');profile_1_image=form.find('#mentor-image-file').val();if(profile_1_image.length>0){var reader=new FileReader();var input=$('#mentor-image-file');reader.readAsDataURL(input[0].files[0]);console.log('bigger than 0');console.log(reader);selected_image=input[0].files[0];form2.append(input.attr('name'),input[0].files[0]);form2.append("action",'sogo_form_mentor_story_submit');form2.append("mentor_image",selected_image);form2.append("image_chosen",'2')}
$.ajax({type:'POST',url:sogo.ajaxurl,cache:!1,contentType:!1,processData:!1,xhr:function(){var myXhr=$.ajaxSettings.xhr();return myXhr},data:form2,success:function(response){console.log(response);console.log('RESPONSE');$('.cube-mentor-image').find('img').attr('src',response);var form=$('#form-mentor-image');form.find('input[type="radio"]:checked').removeAttr('checked');form.find('#mentor-image-file').val('')}})});$('#mentor-image-file').on('change',function(){var form=$('#form-mentor-image');var selected_image=$(this).val();var file=$(this)[0].files[0];console.log(selected_image);console.log(file);readURL(this)});function readURL(input){if(input.files&&input.files[0]){var reader=new FileReader();reader.onload=function(e){$('#mentor-image-img').attr('src',e.target.result)};reader.readAsDataURL(input.files[0])}}
$('#filter_group').on('change',function(){var id=$('#filter_group option:selected');$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_change_students_slide','filter_group':id.val(),},success:function(response){console.log(response);$('.members-slider').replaceWith(response)}})});$(document).on('click','.students-next',function(){var page=$(this).data('val');$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_change_students_slide','paged':page,'filter_group':$('#filter_group').val()},success:function(response){console.log(response);$('.members-slider').replaceWith(response)}})});$(document).on('click','.students-prev',function(){var page=$(this).data('val');$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_change_students_slide','paged':page,'filter_group':$('#filter_group').val()},success:function(response){console.log(response);$('.members-slider').replaceWith(response)}})});$('#search-student').on('input',function(e){var searchText=$('#search-student').val();if(searchText===''){$('.searched-student').show()}else{$('.searched-student').hide();$(":contains("+searchText+")").show()}})})})(jQuery)