                                                <span>לאחר ההרשמה יפתח חלון להזנת קוד הקופון</span>
                                            </div>
                                            <div class="row justify-content-center">
                                                <button type="submit" class="col-12 col-md-8 h-button h-button-1 py-2 cursor-pointer heli-register-btn">
                                                    <span class="text-center">${i18n.register_btn || 'המשך'}</span>
                                                </button>
                                            </div>
                                        </form>
                                        <div class="heli-phone-error" style="display:none;"></div>
                                    </div>
                                </div>
