this.state.phone=phone;this.state.hasCoupon=$('#heli-has-coupon').is(':checked');this.showLoading();$.ajax({url:this.config.ajaxurl,type:'POST',data:{action:'heli_phone_lookup',nonce:this.config.nonce,phone:phone,},success:function(response){self.hideLoading();if(!response.success){self.showError(response.data?.message||'שגיאה');return}
const data=response.data;switch(data.action){case 'register':self.showStep('register');break;case 'send_code':self.state.users=data.users;const lastDigits=data.phone_last_numbers||'***';self.$modal.find('.heli-code-sent-msg').text(`${self.config.i18n?.phone_ends_with || 'הקוד נשלח לטלפון המסתיים ב-'}${lastDigits}`);self.showStep('code');self.$modal.find('.heli-otc-input').first().focus();break}},error:function(){self.hideLoading();self.showError('שגיאת תקשורת, נסה שוב')}})},renderUserSelection:function(users){const $list=this.$modal.find('.heli-users-list');$list.empty();users.forEach((user,index)=>{const maskedTz=user.tz?'***'+user.tz.slice(-4):'';const html=`
