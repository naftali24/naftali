                                <div class="modal-body main-area py-4">
                                    <div class="col-12 mx-auto text-center">
                                        <p class="color-16 text-1 heli-phone-subtitle mb-4">שלחנו קוד בן 5 ספרות לנייד שלך</p>
                                        <div class="heli-otc-container justify-content-center mb-4" dir="ltr">
                                            <input type="text" class="heli-otc-input heli-reg-otc" maxlength="1" inputmode="numeric" pattern="[0-9]">
                                            <input type="text" class="heli-otc-input heli-reg-otc" maxlength="1" inputmode="numeric" pattern="[0-9]">
                                            <input type="text" class="heli-otc-input heli-reg-otc" maxlength="1" inputmode="numeric" pattern="[0-9]">
                                            <input type="text" class="heli-otc-input heli-reg-otc" maxlength="1" inputmode="numeric" pattern="[0-9]">
                                            <input type="text" class="heli-otc-input heli-reg-otc" maxlength="1" inputmode="numeric" pattern="[0-9]">
                                        </div>
                                        <div class="heli-phone-error" style="display:none;"></div>
                                        <a href="#" class="heli-resend-code heli-resend-reg-code color-8 text-2 underline">${i18n.resend_code || 'שלח קוד מחדש'}</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Loading overlay -->
                            <div class="heli-phone-loading" style="display:none;">
                                <div class="heli-spinner"></div>
                            </div>
                        </div>
                    </div>
                </div>
            `;$('body').append(modalHtml);this.$modal=$('#heliPhoneAuthModal')},openModal:function(){if(this.$modal.is(':visible')){return}
this.resetState();this.$modal.show();this.showStep('phone');$('#heli-phone-input').focus();if(this.state.openModalAfterLogin||this.state.hasCoupon){this.$modal.find('.heli-coupon-option').hide();this.$modal.find('.heli-coupon-hint-msg').show()}else{this.$modal.find('.heli-coupon-option').show();this.$modal.find('.heli-coupon-hint-msg').hide()}
this.$modal.find('.heli-tz-field').show();this.$modal.find('.heli-reg-tz').prop('required',!0)},closeModal:function(){this.$modal.fadeOut(200);this.resetState(!0)},resetState:function(full){const savedOptions=full?{}:{hasCoupon:this.state.hasCoupon,noRedirect:this.state.noRedirect,openModalAfterLogin:this.state.openModalAfterLogin,successCallback:this.state.successCallback,showTz:this.state.showTz,};this.state={phone:'',users:[],selectedUser:null,step:'phone',hasCoupon:savedOptions.hasCoupon||!1,noRedirect:savedOptions.noRedirect||!1,openModalAfterLogin:savedOptions.openModalAfterLogin||null,successCallback:savedOptions.successCallback||null,showTz:savedOptions.showTz||!1,};$('#heli-phone-input').val('');$('#heli-has-coupon').prop('checked',this.state.hasCoupon);$('.heli-otc-input').val('');$('.heli-phone-error').hide().text('');$('#heli-email-password-toggle').prop('checked',!1);this.$modal.find('.heli-email-password-panel').hide();this.$modal.find('.heli-email-password-email, .heli-email-password-pass').val('');this.$modal.find('.heli-email-password-error').hide().text('')},showStep:function(step){this.state.step=step;this.$modal.find('.heli-phone-step').hide();if(step==='register'){if(this.state.hasCoupon){$('#heli-reg-has-coupon').prop('checked',!0);this.$modal.find('[data-step="register"] .heli-coupon-option').hide();this.$modal.find('.heli-coupon-hint-msg-reg').show()}else{this.$modal.find('[data-step="register"] .heli-coupon-option').show();this.$modal.find('.heli-coupon-hint-msg-reg').hide()}}
this.$modal.find(`[data-step="${step}"]`).fadeIn(200);if(step==='register'&&this.state.phone){this.$modal.find('.heli-reg-phone').val(this.state.phone)}},goBack:function(){const stepOrder=['phone','select_user','code','register'];const currentIndex=stepOrder.indexOf(this.state.step);if(this.state.step==='code'&&this.state.users.length>1){this.showStep('select_user')}else{this.showStep('phone')}},showLoading:function(){this.$modal.find('.heli-phone-loading').show()},hideLoading:function(){this.$modal.find('.heli-phone-loading').hide()},showError:function(message){this.showErrorToast('שגיאה',message,3000)},hideError:function(){$('.heli-toast, .heli-toast-overlay').remove()},showSuccessToast:function(title,message,duration=2000){$('.heli-toast, .heli-toast-overlay').remove();const toastHtml=`
