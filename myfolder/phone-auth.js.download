                                        </div>
                                        <form id="heli-phone-form" class="py-3 color-1 text-size-1 w-100 justify-content-center">
                                            <div class="s-input-group heli-form-group">
                                                <input type="tel"
                                                       id="heli-phone-input"
                                                       class="heli-phone-input ios-keyboard-fix mb-4 valid"
                                                       placeholder="${i18n.phone_placeholder || 'מספר טלפון'}"
