                        <div class="heli-user-info">
                            <div class="heli-user-name">${user.name || 'משתמש'}</div>
                            <div class="heli-user-details">
                                ${maskedTz ? `<span>ת.ז:${maskedTz}</span>` : ''}
                                ${user.email ? `<span>${user.email}</span>` : ''}
                            </div>
                        </div>
                        <button type="button" class="heli-btn heli-btn-secondary heli-user-select-btn" data-user-index="${index}">
                            בחר
