                                                       required
                                                       autocomplete="off"
                                                       autocorrect="off"
                                                       autocapitalize="off"
                                                       spellcheck="false">
                                            </div>
                                            <div class="heli-coupon-switch heli-coupon-option">
                                                <label class="heli-coupon-switch-label" for="heli-has-coupon">${i18n.have_coupon || 'יש לי קופון'}</label>
                                                <label class="heli-switch">
