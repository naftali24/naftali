(function($){'use strict';$(document).ready(function(){$('#opinion-form').on('submit',function(e){e.preventDefault();var commentElement=$('#opinion-text');var comment=commentElement.val();var firstName=$('#first_name').val();var lastName=$('#last_name').val();var email=$('#email').val();var title=$('#title').val();$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_send_comments','comment':comment,'firstName':firstName,'lastName':lastName,'email':email,'title':title},success:function(response){commentElement.val('');commentElement.siblings('.opinion-text-success').remove();commentElement.after("<p class='text-5 color-1 opinion-text-success'>ההודעה נשלחה בהצלחה</p>")}})})})})(jQuery)