(function($){'use strict';$(document).ready(function(){$('.js-vod-slider').slick({infinite:!1,rtl:!0,slidesToShow:4,slidesToScroll:1,draggable:!0,arrows:!0,nextArrow:'<i class="slick-arrow slick-next icon icon-arrowleft color-6 icon-x5"></i>',prevArrow:'<i class="slick-arrow slick-prev icon icon-arrowright color-6 icon-x5"></i>',dots:!1,responsive:[{breakpoint:992,settings:{slidesToShow:2,arrows:!1,centerMode:!0,centerPadding:'60px',}}]});$('.js-vod-slider-3-image').slick({infinite:!1,rtl:!0,slidesToShow:3,slidesToScroll:1,draggable:!0,arrows:!0,nextArrow:'<i class="slick-arrow slick-next icon icon-arrowleft color-6 icon-x5"></i>',prevArrow:'<i class="slick-arrow slick-prev icon icon-arrowright color-6 icon-x5"></i>',dots:!1,responsive:[{breakpoint:992,settings:{slidesToShow:1,arrows:!1,centerMode:!0,centerPadding:'60px',}}]});if($(window).width()<1200){$('.slick-track').addClass('transform')}
var currentSlide=$('.js-vod-slider').slick('slickCurrentSlide')||$('.js-vod-slider-3-image').slick('slickCurrentSlide');$('.slick-prev').toggle(currentSlide!==0);$('.slick-next').toggle(currentSlide!==2);$('.js-vod-slider').one('afterChange',function(){$(this).find('.slick-track').removeClass('transform');$(this).children().show()});$('.js-vod-slider-3-image').one('afterChange',function(){$(this).find('.slick-track').removeClass('transform');$(this).children().show()})})})(jQuery)