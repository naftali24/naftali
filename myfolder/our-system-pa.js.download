(function($){$(document).ready(function(){$('#continueBtnTooltip').tooltip('toggleEnabled')
$('#helliVideoModal').modal('show');$('.continueBtn').prop('disabled',!0);$('.continueBtn').on('click',function(e){location.href=MUrls.dashboard});$('.foodAlternativeModal').on('click',function(e){e.preventDefault();$('#staticBackdrop').modal('show')})
$('.helliSystemItems a').on('click',function(e){e.preventDefault();let that=$(this);$('.helliSystemItems li').removeClass('active');that.parent().addClass('active')});$('.actionTab').on('click',function(){if($(window).width()<768){let that=$(this),chevron,section;section=that.closest('section');chevron=section.find('.leftChevron');let fSection=section.find('.hiddenRow').first();if(fSection.css('display')==='block'){chevron.css({transform:'rotate(-225deg)'})}else{chevron.css({transform:'rotate(-315deg)'})}
section.find('.hiddenRow').slideToggle()}});$('#readMoreBtn').on('click',function(){let dots=$('#dots'),moreText=$('#more'),more2Text=$('#more2'),btnText=$('#readMoreBtn');btnText.remove();let readMoreTxt='<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16">\n'+'                                                        <path fill-rule="evenodd" d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>\n'+'                                                    </svg>\n'+'                                                    <span>קראי עוד</span>';let closeReadMoreTxt='<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"\n'+'                                                         fill="currentColor" class="bi bi-dash" viewBox="0 0 16 16">\n'+'                                                        <path fill-rule="evenodd"\n'+'                                                              d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8z"/>\n'+'                                                    </svg>\n'+'                                                    <span>סגרי</span>';if(dots.css('display')==="none"){dots.css('display','inline');btnText.html(readMoreTxt);moreText.slideUp();more2Text.slideUp()}else{dots.css('display','none');btnText.html(closeReadMoreTxt);moreText.slideDown();more2Text.slideDown()}})})})(jQuery)