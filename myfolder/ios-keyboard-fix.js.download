(function($){'use strict';var isIOSSafari=/iPad|iPhone|iPod/.test(navigator.userAgent)&&/Safari/.test(navigator.userAgent)&&!/CriOS/.test(navigator.userAgent)&&!/FxiOS/.test(navigator.userAgent);if(!isIOSSafari){return}
$(document).ready(function(){function initIOSKeyboardFix(){var $smsInput=$('#smsTz');var $modal=$('#loginPhoneModal');var originalViewportHeight=window.innerHeight;var keyboardOpen=!1;if($smsInput.length===0){return}
$smsInput.off('focus blur');$smsInput.on('touchstart',function(e){e.stopPropagation()});$smsInput.on('focus.ioskeyboard',function(e){var $this=$(this);e.stopImmediatePropagation();setTimeout(function(){keyboardOpen=!0;if(!$this.is(':focus')){$this.focus()}
$this[0].scrollIntoView({behavior:'smooth',block:'center'})},100)});$smsInput.on('input.ioskeyboard',function(e){var $this=$(this);setTimeout(function(){if(keyboardOpen&&!$this.is(':focus')){e.preventDefault();$this.focus()}},10)});$smsInput.on('blur.ioskeyboard',function(e){var $this=$(this);e.stopImmediatePropagation();if(keyboardOpen){setTimeout(function(){var activeElement=document.activeElement;if(activeElement!==$this[0]&&$this.val().length<9){$this.focus()}else if($this.val().length>=9){keyboardOpen=!1}},100)}});var resizeTimeout;$(window).on('resize',function(){clearTimeout(resizeTimeout);resizeTimeout=setTimeout(function(){var currentHeight=window.innerHeight;var heightDifference=originalViewportHeight-currentHeight;if(heightDifference>150){keyboardOpen=!0}else{keyboardOpen=!1}},100)});$modal.on('shown.bs.modal',function(){keyboardOpen=!1;originalViewportHeight=window.innerHeight;setTimeout(function(){$smsInput.focus()},300)});$modal.on('click',function(e){if($(e.target).hasClass('modal')||$(e.target).hasClass('modal-dialog')){if(keyboardOpen){e.stopPropagation();e.preventDefault();return!1}}});$smsInput.on('keydown',function(e){if(e.keyCode===13){var value=$(this).val();if(value.length<9){e.preventDefault();return!1}}});$smsInput.on('paste',function(e){var $this=$(this);setTimeout(function(){if(!$this.is(':focus')){$this.focus()}},10)});$smsInput.on('touchend',function(e){var $this=$(this);setTimeout(function(){if(!$this.is(':focus')){$this.focus()}},50)});$smsInput.on('focusout',function(e){e.preventDefault();e.stopImmediatePropagation();return!1})}
initIOSKeyboardFix();$(document).on('DOMNodeInserted',function(e){if($(e.target).find('#smsTz').length>0||$(e.target).attr('id')==='smsTz'){setTimeout(initIOSKeyboardFix,100)}})});var iosStyles=`
        <style>
        @media screen and (max-device-width: 768px) {
            /* iOS Safari specific fixes */
            .ios-keyboard-fix {
                font-size: 16px !important; /* Prevent zoom on focus */
                transform: translateZ(0); /* Force hardware acceleration */
                -webkit-user-select: text !important;
                user-select: text !important;
                -webkit-appearance: none !important;
                appearance: none !important;
                border-radius: 0 !important;
                background-clip: padding-box !important;
            }
            
            /* Prevent modal from jumping when keyboard opens */
            .modal.fade.show {
                -webkit-transform: none !important;
                transform: none !important;
            }
            
            /* Ensure input is visible when keyboard is open */
            #loginPhoneModal .modal-dialog {
                margin-top: 10px !important;
                margin-bottom: 10px !important;
                transform: none !important;
                -webkit-transform: none !important;
            }
            
            /* Prevent body scroll when modal is open */
            body.modal-open {
                position: fixed !important;
                width: 100% !important;
                height: 100% !important;
                overflow: hidden !important;
            }
            
            /* Specific fixes for the SMS input field */
            #smsTz {
                -webkit-tap-highlight-color: transparent !important;
                -webkit-touch-callout: none !important;
                -webkit-user-select: text !important;
                user-select: text !important;
                outline: none !important;
                resize: none !important;
            }
            
            /* Prevent iOS Safari from adding its own styling */
            #smsTz:focus {
                -webkit-appearance: none !important;
                appearance: none !important;
                outline: none !important;
                box-shadow: none !important;
            }
        }
        </style>
    `;$('head').append(iosStyles)})(jQuery)