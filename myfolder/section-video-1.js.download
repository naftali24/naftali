(function($){'use strict';$(document).ready(function(){var body=$('body');var imgHeight=$('.section-video-1 .img-wrapper').outerHeight();var textHeight=body.hasClass('desktop')?$('.section-video-1 .text-area').outerHeight():3.1*body.css('font-size').replace('px','');var topSectionHeight=imgHeight-textHeight;if(body.hasClass('desktop')){$('.section-video-1 .play-video').css('height',topSectionHeight+'px');$('.section-video-1 .text-area').removeClass('d-inline')}else{}})})(jQuery)