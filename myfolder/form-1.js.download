(function($){'use strict';$(document).ready(function(){var datePicker=$('.datepicker');if($(datePicker).val()!==''){$(datePicker).prev().addClass('labelfocus')}
$("form :input").focus(function(){if(!$(this).prop('readonly')){$("label[for='"+this.id+"']:first-child").addClass("labelfocus")}}).blur(function(){if($(this).val()===''){$("label[for='"+this.id+"']:first-child").removeClass("labelfocus")}});$('input[type="text"].datepicker').on('click',function(){if($(this).attr('readonly')!=='readonly'){if($(this).hasClass('datepicker-from')){console.log('has');$(this).datepicker({onSelect:function(str,obj){$(this).prev().addClass('labelfocus')},changeMonth:!0,changeYear:!0,beforeShow:function(){$(this).datepicker('option','maxDate',$('.datepicker-to').val())}})}else if($(this).hasClass('datepicker-to')){$(this).datepicker({onSelect:function(str,obj){$(this).prev().addClass('labelfocus')},changeMonth:!0,changeYear:!0,beforeShow:function(){$(this).datepicker('option','minDate',$('.datepicker-from').val())}})}}else{console.log('has-2');$(this).datepicker("destroy")}})});$('.datepicker-from-2').datepicker({onSelect:function(str,obj){$(this).prev().addClass('labelfocus')},changeMonth:!0,changeYear:!0,minDate:'-5y',maxDate:'0'});$('#date-picker-1').datepicker({onSelect:function(str,obj){$(this).prev().addClass('labelfocus')},changeMonth:!0,changeYear:!0,maxDate:"-18y",yearRange:"-100:-18",});$('#weight_from_date').datepicker({onSelect:function(str,obj){$(this).prev().addClass('labelfocus')},changeMonth:!0,changeYear:!0,minDate:null,maxDate:null});$('#target_time').datepicker({onSelect:function(str,obj){$(this).prev().addClass('labelfocus')},changeMonth:!0,changeYear:!0,});$('.datepicker-to-2').datepicker({onSelect:function(str,obj){$(this).prev().addClass('labelfocus')},changeMonth:!0,changeYear:!0,maxDate:'0',beforeShow:function(){$(this).datepicker('option','minDate',$('.datepicker-from-2').val())}})})(jQuery)