(function($){'use strict';$(document).ready(function(){$(window).load(function(){$('#js-products-slider .loop-start').slick({rtl:!0,slidesToShow:4,infinite:!1,arrows:!0,nextArrow:'<span class="slick-arrow slick-arrow-2 slick-next icon icon-arrowright color-6 icon-x5"></span>',prevArrow:'<span class="slick-arrow slick-arrow-2 slick-prev icon icon-arrowleft color-6 icon-x5"></span>',dots:!1,responsive:[{breakpoint:992,settings:{arrows:!1,slidesToShow:2,centerPadding:'15%',centerMode:!1}},{breakpoint:767,settings:{arrows:!1,slidesToShow:1,centerPadding:'15%',centerMode:!0}}]})});$('.section-product-3 .product-box').on('mouseenter',function(){$(this).closest('.section-product-3').find('.view-all-position').css('z-index','-1')});$('.section-product-3 .product-box').on('mouseleave',function(){$(this).closest('.section-product-3').find('.view-all-position').css('z-index','0')})})})(jQuery)