(function($){'use strict';const config=window.heliPhoneAuth||{};function getI18n(key,fallback){return config.i18n&&config.i18n[key]?config.i18n[key]:fallback}
function isValidEmail(email){return/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)}
function isTzInput(val){return/^\d{5,9}$/.test(val)}
function showError($wrapper,message){const $error=$wrapper.find('.heli-email-password-error');$error.text(message).stop(!0,!0).slideDown(150)}
function hideError($wrapper){$wrapper.find('.heli-email-password-error').stop(!0,!0).slideUp(120).text('')}
function openCouponModal(){if($('#couponNumberModal').length){$('#couponNumberModal').modal('show');return}
const url=new URL(window.location.href);url.searchParams.set('openmodal','#couponNumberModal');window.location.href=url.toString()}
function goToRedirect(redirect){if(!redirect){window.location.reload();return}
let redirectUrl=redirect;if(redirectUrl.indexOf('chooseplan')!==-1){const url=new URL(redirectUrl,window.location.origin);url.searchParams.set('debugcouponmodal','');redirectUrl=url.toString()}
window.location.href=redirectUrl}
function handleLoginSuccess(data,hasCoupon){if(window.HeliPhoneAuth&&typeof window.HeliPhoneAuth.closeModal==='function'){window.HeliPhoneAuth.closeModal()}else if($('#heliPhoneAuthModal').length){$('#heliPhoneAuthModal').hide()}
const shouldOpenCoupon=hasCoupon||!!data.isOpenCouponModal;const useToasts=window.HeliPhoneAuth&&typeof window.HeliPhoneAuth.showSuccessToast==='function';const delay=useToasts?1000:0;if(useToasts){window.HeliPhoneAuth.showSuccessToast('התחברת בהצלחה!',shouldOpenCoupon?'פותח מודל קופון...':'',1000)}
setTimeout(function(){if(shouldOpenCoupon){openCouponModal();return}
goToRedirect(data.redirect||'')},delay)}
function submitEmailPassword($form){const $wrapper=$form.closest('.heli-email-password-login-wrap');const $submit=$form.find('.heli-email-password-submit');const email=$.trim($form.find('.heli-email-password-email').val()||'');const password=$form.find('.heli-email-password-pass').val()||'';const hasCoupon=$('#heli-has-coupon').length?$('#heli-has-coupon').is(':checked'):$form.find('.heli-email-password-coupon').is(':checked');hideError($wrapper);if(!email){showError($wrapper,getI18n('email_required','יש להזין אימייל או ת.ז'));return}
if(!isTzInput(email)&&!isValidEmail(email)){showError($wrapper,getI18n('invalid_input','יש להזין אימייל תקין או מספר ת.ז'));return}
if(!password){showError($wrapper,getI18n('password_required','יש להזין סיסמה'));return}
$submit.prop('disabled',!0).addClass('is-loading');$.ajax({url:config.ajaxurl||'/wp-admin/admin-ajax.php',type:'POST',dataType:'json',data:{action:'heli_email_password_login',nonce:config.nonce||'',email:email,password:password,hasCoupon:hasCoupon?1:0}}).done(function(response){if(!response||!response.success){const message=response&&response.data&&response.data.message?response.data.message:getI18n('login_failed','פרטי ההתחברות שגויים');showError($wrapper,message);return}
handleLoginSuccess(response.data||{},hasCoupon)}).fail(function(){showError($wrapper,getI18n('communication_error','שגיאת תקשורת, נסה שוב'))}).always(function(){$submit.prop('disabled',!1).removeClass('is-loading')})}
$(document).on('change','.heli-email-password-toggle',function(){const $wrapper=$(this).closest('.heli-email-password-login-wrap');const $panel=$wrapper.find('.heli-email-password-panel');console.log('here')
hideError($wrapper);if($(this).is(':checked')){$panel.stop(!0,!0).slideDown(180)}else{$panel.stop(!0,!0).slideUp(140)}});$(document).on('submit','.heli-email-password-form',function(e){e.preventDefault();submitEmailPassword($(this))})})(jQuery)