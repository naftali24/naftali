(function($){'use strict';$(document).ready(function(){if($('body').hasClass('mobile')){$('.card-slider').slick({slide:'div',rtl:!0,slidesToShow:3,arrows:!0,nextArrow:'<i class="icon-arrowleft icon-x5 color-white"></i>',prevArrow:'<i class="icon-arrowright icon-x5 color-white"></i>',dots:!1,responsive:[{breakpoint:992,settings:{slidesToShow:2}},{breakpoint:768,settings:{slidesToShow:1}}]})}})})(jQuery)