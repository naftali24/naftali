(function($){'use strict';$(document).ready(function(){$('#recipe-tax-slider').slick({rtl:!0,slidesToShow:11,slidesToScroll:4,arrows:!0,infinite:!0,draggable:!0,nextArrow:'<span class="slick-arrow slick-arrow-2 slick-next icon icon-arrowright color-6 icon-x5"></span>',prevArrow:'<span class="slick-arrow slick-arrow-2 slick-prev icon icon-arrowleft color-6 icon-x5"></span>',dots:!1,initialSlide:slickSlideIndex(),responsive:[{breakpoint:1500,settings:{slidesToShow:9}},{breakpoint:1200,settings:{slidesToShow:7}},{breakpoint:800,settings:{centerMode:!0,arrows:!1,centerPadding:"50px",slidesToShow:6}},{breakpoint:450,settings:{centerMode:!0,arrows:!1,centerPadding:"60px",slidesToShow:2,initialSlide:slickSlideIndex()}}]});function slickSlideIndex(){var slickIndex=$('#recipe-tax-slider .slick-current').data('slick-index');return slickIndex}})})(jQuery)