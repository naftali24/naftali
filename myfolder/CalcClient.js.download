function Kissing() {
    if (document.getElementById("listSeconds").value != "0" && document.getElementById("kissKind").value != "0") {
        $.ajax({
            type: "POST",
            url: "Methods.asmx/GetKissingCalory",
            contentType: "application/json; charset=utf-8",
            data: "{'minutes': '" + document.getElementById("listMinutes").value + "','seconds': '" + document.getElementById("listSeconds").value + "','kissKind': '" + document.getElementById("kissKind").value + "'}",
            dataType: "json",
            success: function(result) {
                document.getElementById("resultLabel").innerHTML = "סה''כ שרפתם " + result.d[0] + " קלוריות";
            },
            error: AjaxFailed
        });
    }
    else
        if (document.getElementById("kissKind").value == "0") {
            document.getElementById('resultLabel').innerHTML = '';
            document.getElementById('descriptionLabel').innerHTML = '';
    }
}

function fillDrops(sFoval, myBox, low, high) {
    sList = document.getElementById(myBox);

    for (i = 0; i < sList.options.length; i++)
        sList.options[i] = null;

    for (i = low; i <= high; i++) {
        sList.options[0] = new Option(sFoval, 0);
        sList.options[i - low] = new Option("  " + i, i);
    }
}

function LoveMatch() {
    if (document.getElementById("name").value != "" && document.getElementById("couples").value != "") {
        $.ajax({
            type: "POST",
            url: "Methods.asmx/GetLoveMatch",
            contentType: "application/json; charset=utf-8",
            data: "{'name': '" + document.getElementById("name").value + "','couples': '" + document.getElementById("couples").value + "'}",
            dataType: "json",
            success: function(result) {
            document.getElementById("a1").value = result.d[0];
            document.getElementById("a2").value = result.d[1];
            document.getElementById("a3").value = result.d[2];
            document.getElementById("a4").value = result.d[3];
            document.getElementById("a5").value = result.d[4]; 
            },
            error: AjaxFailed
        });
    }
}
function CalculateActive() {
    var activity = document.getElementById("ctl00_CalcBody_activity").value;
    var wights = document.getElementById("weight").value;
    var times = document.getElementById("timeActive").value;

    if (times!="" && !IsNumeric(times)) {
        document.getElementById("resultLabel").innerHTML = "";
        document.getElementById("descriptionLabel").innerHTML = "";
        alert("משך פעילות - מספרים בלבד");
        return false;
    }
    
    var j = document.getElementsByName("genderRadio");
    var Gender = "";
    for (i = 0; i < j.length; i++) {
        if (j[i].checked)
            Gender = j[i].value
    }
    if (activity != "0" && wights != "0" && times != "") {
        $.ajax({
            type: "POST",
            url: "Methods.asmx/ChildrenActivitates",
            contentType: "application/json; charset=utf-8",
            data: "{'activity': '" + activity + "','weight': '" + wights + "','times': '" + times + "','Gender': '" + Gender + "'}",
            dataType: "json",
            success: function(result) {
                document.getElementById("descriptionLabel").innerHTML = "";
                document.getElementById("resultLabel").innerHTML = "סה''כ הוצאה קלורית: " + result.d[0];
            },
            error: AjaxFailed
        });
    }
    else {
        document.getElementById("resultLabel").innerHTML = "";
        document.getElementById("descriptionLabel").innerHTML = "";
    }
}
function loadSelectDroplist(sFoval, myBox, low, high) {
    var sList = document.getElementById(myBox);
    for (i = 0; i < sList.options.length; i++)
        sList.options[i] = null;
    for (i = low; i <= high; i++) {
        sList.options[0] = new Option(sFoval, 0);
        sList.options[i - low] = new Option("  " + i, i);
    }
}
