function AminoDaily() {
    var Gender = "";
    var j = document.getElementsByName("Sex"); 
    for (i = 0; i < j.length; i++) {
        if (j[i].checked)
            Gender = j[i].value
    }

    var aminoSelect = document.getElementById("SelectAmino").value;
    if (aminoSelect != "0") {
        $.ajax({
            type: "POST",
            url: "Methods.asmx/GetAminoDailyResults",
            contentType: "application/json; charset=utf-8",
            data: "{'aminoName': '" + aminoSelect + "','gender': '" + Gender + "'}",
            dataType: "json",
            success: function(result) {
                document.getElementById("resultLabel").innerHTML = result.d[0];
                document.getElementById("descriptionLabel").innerHTML = result.d[1];
                document.getElementById("explain").innerHTML = result.d[2];
            },
            error: AjaxFailed
        });
    }
    else {
        document.getElementById("resultLabel").innerHTML ="";
        document.getElementById("descriptionLabel").innerHTML = "";
    }
}

function AjaxFailed(result) {
    //alert(result.status + ' ' + result.statusText);
}

