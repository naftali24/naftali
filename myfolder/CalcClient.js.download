}

function AshleganDaily() {
    var age = document.getElementById("SelectAge").value;
    var wights = document.getElementById("weights").value;

    if (!IsNumeric(wights)) {
        document.getElementById("resultLabel").innerHTML = "";
        document.getElementById("descriptionLabel").innerHTML = "";
        return false;
    }
    
    if (age != "0" && wights!="0") {
        $.ajax({
            type: "POST",
            url: "Methods.asmx/GetAshleganDaily",
            contentType: "application/json; charset=utf-8",
            data: "{'age': '" + age + "','weights': '" + wights + "'}",
            dataType: "json",
            success: function(result) {
                document.getElementById("resultLabel").innerHTML = result.d[0].Text;
                document.getElementById("descriptionLabel").innerHTML = result.d[0].Value;
            },
            error: AjaxFailed
        });
    }
    else {
        document.getElementById("resultLabel").innerHTML = "";
        document.getElementById("descriptionLabel").innerHTML = "";
    }
}

