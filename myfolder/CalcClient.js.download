function Vitamis(num) {
    var age = document.getElementById("a1").value;
    var j = document.getElementsByName("Sex");
    var Sex = ""; 
    for (i = 0; i < j.length; i++) {
        if (j[i].checked)
            Sex = j[i].value
    }

    if (age != "0") {
        $.ajax({
            type: "POST",
            url: "Methods.asmx/GetVitmin" + num,
            contentType: "application/json; charset=utf-8",
            data: "{'age': '" + age + "', 'gender': '" + Sex + "'}",
            dataType: "json",
            success: function(result) {
                document.getElementById("a2").value = result.d[0];
                document.getElementById("max").value = result.d[1];
                document.getElementById("descriptionLabel").innerHTML = "";
                if (result.d[1] == "טנ")
                    document.getElementById("descriptionLabel").innerHTML = "טנ= טרם נקבע בשל מחסור בנתונים לגבי תופעות לוואי בקבוצת הגיל המסוימת, וחשש לחוסר יכולת להתמודד עם כמויות עודפות. מומלץ שמקור הרכיבים יהיה מזון בלבד, על מנת להימנע מרמות  גבוהות.";
                if (result.d[2] != undefined && result.d[2] != null && result.d[2] == "8")
                    document.getElementById("descriptionLabel").innerHTML += "<br /><br />מכיוון שאצל 10%-30% מן האנשים המבוגרים עלולה להיות תת-ספיגה של ויטמין B12 מן המזון, מומלץ כי אנשים מעל גיל 50 יגיעו לצריכה המומלצת בעיקר באמצעות צריכת מזון מועשר בויטמין B12, או באמצעות צריכת תוסף תזונה המכיל ויטמין זה.";
            },
            error: AjaxFailed
        });
    }
    else {
        document.getElementById("a2").value = "";
        document.getElementById("descriptionLabel").innerHTML = "";
        document.getElementById("max").value = "";
    }
}
