            success: function(result) {
                document.getElementById("a2").value = result.d[0];
                document.getElementById("max").value = result.d[1];
                if (result.d[1] == "טנ")
                    document.getElementById("descriptionLabel").innerHTML = "טנ= טרם נקבע בשל מחסור בנתונים לגבי תופעות לוואי בקבוצת הגיל המסוימת, וחשש לחוסר יכולת להתמודד עם כמויות עודפות. מומלץ שמקור הרכיבים יהיה מזון בלבד, על מנת להימנע מרמות  גבוהות.";
                else
                    document.getElementById("descriptionLabel").innerHTML = "";
            },
            error: AjaxFailed
        });
    }
    else {
        document.getElementById("a2").value = "";
        document.getElementById("descriptionLabel").innerHTML = "";
        document.getElementById("max").value = "";
    }
}
