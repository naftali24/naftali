(function($){'use strict';let mentor_id='';$(document).ready(function(){$('.clean-btn').on('click',function(e){let url=window.location.host+'/vod/';window.location.href='https://'+url});$('.mentor-name').click(function(){mentor_id=this.id;let montor_name=$(this).html().trim();alert(montor_name)
if(montor_name){$("#mentor-name-selected:text").val(montor_name);$('#modal-mentor').modal('hide')}});$('.search-filter').click(function(){let flr_from_date=$('#flr_from_date').val();let flr_to_date=$('#flr_to_date').val();let mentorId=mentor_id;document.location.href="?flr_mentor="+mentorId+"&flr_from_date="+flr_from_date+"&flr_to_date="+flr_to_date});$('#search-video-filter').on('click',function(){let query_search=$('#search-video').val();document.location.href="?search_video="+query_search})})})(jQuery)