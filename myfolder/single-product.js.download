(function($){'use strict';$(document).ready(function(){});$(window).load(function(){$('body').on('click','.stars a',function(){var $rating=$(this).closest('#respond').find('#rating');$("#rating").val($rating.val());$(this).closest('#respond').parent().append($('<div class="text-6 color-3 text-center pt-1">תודה על ההצבעה</div>'));$(this).closest('form').find('#submit').trigger('click')})})})(jQuery)