(function($){'use strict';$(document).ready(function(){$('#form-dashboard-save').on('click',function(e){e.preventDefault();$(this).addClass('d-none');$(this).siblings().addClass('d-none');$(this).siblings('.d-none').first().removeClass('d-none');$('#edit-weight').addClass('d-none');$('#show-weight').removeClass('d-none');var form=$('#form-dashboard');console.log(form);form.find('input').each(function(){$(this).attr('readonly','readonly');if($(this).val()===''){$("label[for='"+this.id+"']").removeClass("labelfocus")}});$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_form_dashboard_submit','form':form.serialize()},success:function(response){console.log(response)}});console.log('testonnn')
$('#my-current-weight').text($('#weight').val());if($('#weight').val().length>0){$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'sogo_update_weight','weight':$('#weight').val()},success:function(response){if(response.error){alert(response.message)
return}
location.reload();console.log(response)}})}
form.find('.datepicker').trigger('click')});$('#weeklyMessage').click(function(){if($('.icon').hasClass('icon-plus')){$('.icon').removeClass('icon-plus');$('.icon').addClass('icon-minus')}else{$('.icon').removeClass('icon-minus');$('.icon').addClass('icon-plus')}});$('#wight_filter_btn').on('click',function(){let weight_from_date=$('#weight_from_date').val();let weight_to_date=$('#weight_to_date').val();document.location.href="?weight_from_date="+weight_from_date})
$('.clear-weight-filter').on('click',function(){$.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'heli_clear_wight_filter','param':'clear-filter'},success:function(response){if(!response.data.error){window.location.href=response.data.redirect_url}else{console.log(response.data.error)}}})})
jQuery.fn.liScroll=function(settings){settings=jQuery.extend({travelocity:0.03},settings);return this.each(function(){var $strip=jQuery(this);$strip.addClass("newsticker")
var stripHeight=1;$strip.find("li").each(function(i){stripHeight+=jQuery(this,i).outerHeight(!0)});var $mask=$strip.wrap("<div class='mask'></div>");var $tickercontainer=$strip.parent().wrap("<div class='tickercontainer'></div>");var containerHeight=$strip.parent().parent().height();$strip.height(stripHeight);var totalTravel=stripHeight;var defTiming=totalTravel/settings.travelocity;function scrollnews(spazio,tempo){$strip.animate({top:'-='+spazio},tempo,"linear",function(){$strip.css("top",containerHeight);scrollnews(totalTravel,defTiming)})}
scrollnews(totalTravel,defTiming);$strip.hover(function(){jQuery(this).stop()},function(){var offset=jQuery(this).offset();var residualSpace=offset.top+stripHeight;var residualTime=residualSpace/settings.travelocity;scrollnews(residualSpace,residualTime)})})};$(function(){$("ul#ticker01").removeClass('d-none').liScroll()});function activaTab(tab){$('.tab-graph a[href="#'+tab+'"]').tab('show')}})})(jQuery)