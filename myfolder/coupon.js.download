(function($){'use strict';$(document).ready(function(){$('#couponCheckBtn').on('click',function(){let coupon=$('#couponNum').val();let userTz=$('#userTz').val();let password=$('#password').val();const isDtsSpecialCoupon=$('#specialCouponCheck').is(':checked');$('#couponCheckBtn').addClass('d-none');if(!coupon||!userTz){iziToast.error({title:'שגיאה!:',message:'יש להזין את כל הפרטים',rtl:!0,position:'center',});$('#couponCheckBtn').removeClass('d-none')}else{$.ajax({type:"POST",dataType:"json",url:sogo.ajaxurl,data:{'action':'heli_get_coupon_by_code_office','coupon':coupon,'userTz':userTz,'password':password,'isDtsSpecialCoupon':isDtsSpecialCoupon},success:function(response){if(!response.data.error){iziToast.success({title:'מעולה!:',message:response.data.message,rtl:!0,position:'center',});$('#companyInfo').removeClass('d-none');$('.update-coupon-wrapper').removeClass('d-none');$('#companyName').html(response.data.description)}else{iziToast.error({title:'שגיאה!:',message:response.data.message,rtl:!0,position:'center',});if(response.data.isShowRemoveBtn){$('.remove-coupon-wrapper').removeClass('d-none')}
$('#couponCheckBtn').removeClass('d-none')}}})}});$('#updateCouponBtn').on('click',function(){let coupon=$('#couponNum').val();let userTz=$('#userTz').val();let password=$('#password').val();const isDtsSpecialCoupon=$('#specialCouponCheck').is(':checked');$('#updateCouponBtn').addClass('d-none');if(!coupon){iziToast.error({title:'שגיאה!:',message:'יש להזין קופון',rtl:!0,position:'center',})}else{$.ajax({type:"POST",dataType:"json",url:sogo.ajaxurl,data:{'action':'heli_apply_coupon_by_office','couponNum':coupon,'userTz':userTz,'password':password,'type':'apply_coupon','isDtsSpecialCoupon':isDtsSpecialCoupon},success:function(response){if(!response.data.error){iziToast.success({title:'מעולה!:',message:response.data.message,rtl:!0,position:'center',});setTimeout(()=>{window.location.reload()},3000)}else{iziToast.error({title:'שגיאה!:',message:response.data.message,rtl:!0,position:'center',})}}})}})
$('#removeCouponBtn').on('click',function(){let coupon=$('#couponNum').val();let userTz=$('#userTz').val();let password=$('#password').val();if(!coupon){iziToast.error({title:'שגיאה!:',message:'יש להזין קופון',rtl:!0,position:'center',})}else{$.ajax({type:"POST",dataType:"json",url:sogo.ajaxurl,data:{'action':'heli_apply_coupon_by_office','couponNum':coupon,'userTz':userTz,'password':password,'type':'remove_coupon'},success:function(response){if(!response.data.error){iziToast.success({title:'מעולה!:',message:response.data.message,rtl:!0,position:'center',});$('#companyCoupon').val(' ');$('#companyInfo').addClass('d-none');$('.remove-coupon-wrapper').addClass('d-none')}else{iziToast.error({title:'שגיאה!:',message:response.data.message,rtl:!0,position:'center',})}}})}})})}(jQuery))