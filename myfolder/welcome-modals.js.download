(function($){'use strict';$(document).ready(function(){$('#heliLevelEndWeekSix').modal('show');$('#heliLevelWeightMaintenance').modal('show');$('#heliTermsAndConditionsModal').modal('show');$('.welcome-modal-btn').on('click',function(){jQuery.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'heli_update_modal_completed','data':'main_welcome_modal'},success:function(response){if(!response.data.error){$('#heliMediaLinksModal').modal('show')}}})});$('.facebook-link-btn').on('click',function(){jQuery.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'heli_update_modal_completed','data':'media-modal'},success:function(response){if(!response.data.error){$('#heliMediaLinksModal').modal('hide');if(response.data.redirect){window.location.href=response.data.redirect}
if(!response.data.error){window.ReactNativeWebView.postMessage("registerSuccess")}}}})});$('.terms-and-conditions-btn').on('click',function(){jQuery.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'heli_update_modal_completed','data':'terms-and-conditions-modal'},success:function(response){if(!response.data.error){$('#heliTermsAndConditionsModal').modal('hide');if(!response.data.error){$('#heliMediaLinksModal').modal('show')}}}})});$('.levels-modal-btn').on('click',function(){jQuery.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'heli_update_modal_completed','data':'levels-end-week-six-modal'},success:function(response){if(!response.data.error){$('#heliLevelEndWeekSix').modal('hide')}}})});$('.levels-modal-weight-maintenance-btn').on('click',function(){jQuery.ajax({type:'POST',url:sogo.ajaxurl,data:{'action':'heli_update_modal_completed','data':'levels-weight-maintenance-modal'},success:function(response){if(!response.data.error){$('#heliLevelWeightMaintenance').modal('hide')}}})})})})(jQuery)