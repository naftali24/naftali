function Send2(Type) {

    var a1 = document.getElementById("a1").value;
    var a2 = document.getElementById("a2").value;
    var a3 = document.getElementById("a3").value;
    var a4 = document.getElementById("a4").value;
    var a5 = document.getElementById("a5").value;
    var a6 = document.getElementById("a6").value;
    var a7 = document.getElementById("a7").value;
    var a8 = document.getElementById("a8").value;
    var a9 = document.getElementById("a9").value;
    var a10 = document.getElementById("a10").value;
    var a11 = document.getElementById("a11").value;
    var a12 = document.getElementById("a12").value;
    

    if ((a10 == "") && (Type == 1)) {

        document.getElementById("a11").value = "";
        document.getElementById("a12").value = "";

    }
    else if (((a1 == "") || (a2 == "") || (a3 == "")) && (Type == 0)) {
 
        document.getElementById("a4").value = "";
        document.getElementById("a5").value = "";
        document.getElementById("a6").value = "";
        document.getElementById("a7").value = "";
        document.getElementById("a8").value = "";
        document.getElementById("a9").value = "";
        

    }
    else {
        if (IsNumeric(a1) && IsNumeric(a2) && IsNumeric(a3)) {

            if ((a10 != "") && (!IsNumeric(a10))) {
                return;
            }

        var xmlString = '<result Type="' + Type + '"  a1="' + a1 + '"   a2="' + a2 + '"   a3="' + a3 + '"  a10="' + a10 + '"  ></result>';

        var action = 'Send2';
        GenericF(xmlString, action);
        }
    
    }

   


}

function Back2(xmlString) {

    var xmlDoc = GetxDoc(xmlString);
    var Type = xmlDoc.firstChild.getAttribute("Type");


    if (Type == "0") {
        document.getElementById("a4").value = xmlDoc.firstChild.getAttribute("a4");
        document.getElementById("a5").value = xmlDoc.firstChild.getAttribute("a5");
        document.getElementById("a6").value = xmlDoc.firstChild.getAttribute("a6");
        document.getElementById("a7").value = xmlDoc.firstChild.getAttribute("a7");
        document.getElementById("a8").value = xmlDoc.firstChild.getAttribute("a8");
        document.getElementById("a9").value = addSeparatorsNF(Math.round((parseFloat(xmlDoc.firstChild.getAttribute("a9"))) * 10) / 10, '.', '.', ',');
    }
    else if (Type == "1") {

        document.getElementById("a4").value = xmlDoc.firstChild.getAttribute("a4");
        document.getElementById("a5").value = parseFloat(xmlDoc.firstChild.getAttribute("a5")).toFixed(1);
        document.getElementById("a6").value = parseFloat(xmlDoc.firstChild.getAttribute("a6")).toFixed(1);
        document.getElementById("a7").value = parseFloat(xmlDoc.firstChild.getAttribute("a7")).toFixed(1);
        document.getElementById("a8").value = parseFloat(xmlDoc.firstChild.getAttribute("a8")).toFixed(1);
        document.getElementById("a9").value = addSeparatorsNF(Math.round(parseFloat(xmlDoc.firstChild.getAttribute("a9")) * 10) / 10, '.', '.', ',');
        document.getElementById("a11").value = parseFloat(xmlDoc.firstChild.getAttribute("a11")).toFixed(0);
        document.getElementById("a12").value = parseFloat(xmlDoc.firstChild.getAttribute("a12")).toFixed(0); 
    }
}

