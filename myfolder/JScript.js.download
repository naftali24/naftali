function Send7() {


    var height = document.getElementById('height').value;
    var age = document.getElementById('age').value;
    var weight = document.getElementById('weight').value;
    var WorkSpeed = document.getElementById('WorkSpeed').value;
    var pulse = document.getElementById('pulse').value;

    if ((height == "") || (age == "") || (weight == "") || (WorkSpeed == "") || (pulse == "")) {

        return;
    }

    var Gender = "";
    var j = document.getElementsByName("Sex");

    for (i = 0; i < j.length; i++) {
        if (j[i].checked)
            Gender = j[i].value
    }

    var xmlString = "";

    var Type = "";



    if (!IsNumeric(height) || !IsNumeric(age) || !IsNumeric(weight) || !IsNumeric(WorkSpeed) || !IsNumeric(pulse)) {
        return;
    }


    if (Gender == "1") {
        Type = "M";
    }
    else {
        Type = "F";
    }

    xmlString = '<result height="' + height + '" age="' + age + '" weight="' + weight + '" WorkSpeed="' + WorkSpeed + '" pulse="' + pulse + '" Type="' + Type + '"  ></result>';

    var action = 'Send7';

    GenericF(xmlString, action);

}



function Back7(xmlString) {

    var xmlDoc = GetxDoc(xmlString);

    if (document.getElementById("height").value <= 240 && document.getElementById("age").value <= 100 && document.getElementById("weight").value <= 250 && document.getElementById("WorkSpeed").value <= 30 && document.getElementById("pulse").value <= 240) 
    {
        if (xmlDoc.firstChild.getAttribute("Type") == "F") {
            document.getElementById("TextRes").value = Math.round(parseFloat(xmlDoc.firstChild.getAttribute("TextRes")) * 10) / 10;
            document.getElementById("TextResW").value = xmlDoc.firstChild.getAttribute("TextResW").replace("נמןך", "נמוך");
        }
        else {
            document.getElementById("TextRes").value = Math.round(parseFloat(xmlDoc.firstChild.getAttribute("TextRes")) * 10) / 10;
            document.getElementById("TextResW").value = xmlDoc.firstChild.getAttribute("TextResW").replace("נמןך", "נמוך");
        }
        document.getElementById("descriptionLabel").innerHTML = "";
    }
    else { document.getElementById("descriptionLabel").innerHTML = "<span>הנתונים אינם תקינים!!</span>"; document.getElementById("TextRes").value = ""; document.getElementById("TextResW").value = ""; }
}

