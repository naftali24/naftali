function Change2(Selected, counter) {
    for (i = 1; i <= counter; i++) {
        if (i == Selected) {
            document.getElementById("DetailCardSub" + i).style.display = 'block';
            document.getElementById("DetailCard" + i).className = 'selected';
        }
        else {
            document.getElementById("DetailCardSub" + i).style.display = 'none';
            document.getElementById("DetailCard" + i).className = '';
            if (document.getElementById("DetailCardMenuSub1") != null) {
                document.getElementById("DetailCardMenuSub1").style.display = 'none';
                document.getElementById("DetailCardMenu1").className = '';
            }
            if (document.getElementById("DetailCardMenuSub2") != null) {
                document.getElementById("DetailCardMenuSub2").style.display = 'none';
                document.getElementById("DetailCardMenu2").className = '';
            }
        }
    }
}