function Send1After(hVal) {

    var timeInput = document.getElementById("timeInput").value;



    if ((timeInput != "") && !IsNumeric(timeInput)) {
        document.getElementById("ResponseValue").innerHTML = "";
        document.getElementById("mySelect").value = "a0";
        return;
        }

        
    var mskal = document.getElementById("mskal").value;
    if ((mskal != "") && !IsNumeric(mskal)) {
        document.getElementById("ResponseValue").innerHTML = "";
        document.getElementById("mySelect").value = "a0";
        return;
    }


    if (hVal == "a0") {
        document.getElementById("ResponseValue").innerHTML = "";
        return;
    }

    if (mskal == "" || timeInput == "" || document.getElementById("mySelect").value == "a0")
    { document.getElementById("ResponseValue").innerHTML ="";return false;}

    var xmlString = '<result timeInput="' + timeInput + '"  mskal="' + mskal + '"  hVal="' + hVal + '" ></result>';
    var action = 'Send1';

 
    GenericF(xmlString, action);
 

}
 



function Back1(xmlString) {

    var xmlDoc = GetxDoc(xmlString);

    var hVal = xmlDoc.firstChild.getAttribute("hVal");
    var hValString = document.getElementById(hVal).innerHTML;
      
    document.getElementById("ResponseValue").innerHTML = xmlDoc.firstChild.getAttribute(hVal) + " קלוריות " ;
     

}

