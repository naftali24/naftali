function Back6(xmlString) {

    var xmlDoc = GetxDoc(xmlString);

    if (xmlDoc.firstChild.getAttribute("Type") == "F") {
        if (xmlDoc.firstChild.getAttribute("Res") == "")
            document.getElementById("TextF").value = "טוב מאוד";
        else
            document.getElementById("TextF").value = xmlDoc.firstChild.getAttribute("Res");
    }
    else {
        document.getElementById("TextM").value = xmlDoc.firstChild.getAttribute("Res");
    }
}

