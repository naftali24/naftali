function Send3(IsClean) {


    if ((document.getElementById("Text1").value == "") || (document.getElementById("Text2").value == "") || (IsClean == 0)) {

        document.getElementById("Text1").value = "";
        document.getElementById("Text2").value = "";
        document.getElementById("Text3").value = "";
        document.getElementById("Text4").value = "";

        return;

    }


    var OldWeight = document.getElementById("Text1").value;
    var NewWeight = document.getElementById("Text2").value;

     
    if (!IsNumeric(NewWeight) || !IsNumeric(OldWeight)) {
      return;
    }

    var xmlString = '<result OldWeight="' + OldWeight + '"  NewWeight="' + NewWeight + '" ></result>';
    var action = 'Send3';



    GenericF(xmlString, action);


}

