        document.getElementById(descriptionLabel).innerHTML = "";
    }
    else {
        showResult(result, resultLabel, center);
        var gender = (document.getElementById('maleRadio').checked) ? "male" : "female";
        showClassification(descriptionLabel, result, gender);
    }
}


