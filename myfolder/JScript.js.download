//////////////////////////////// Start ChildFat ////////////
function SendChildFat() {

    var Gender = "";
    var j = document.getElementsByName("Sex"); //alert(j)

    for (i = 0; i < j.length; i++) {
        if (j[i].checked)
            Gender = j[i].value
    }
    
    var IsNotEmpty = false;
    if (Gender != "" && document.getElementById("a3").value != "" && document.getElementById("a4").value != "")
        IsNotEmpty = true;

    if (IsNotEmpty) {
        $.ajax({
            type: "POST",
            url: "Methods.asmx/GetChildFatPrecent",
            contentType: "application/json; charset=utf-8",
            data: "{'gender': '" + Gender + "','hand': '" + document.getElementById("a3").value + "','shoulder': '" + document.getElementById("a4").value + "'}",
            dataType: "json",
            success: function(result) {
                if (result.d[0] == undefined || result.d[1] == undefined) {
                    document.getElementById("a5").value = "";
                    document.getElementById("a6").value = "גבוה מאוד";
                }
                else {
                    document.getElementById("a5").value = result.d[0];
                    document.getElementById("a6").value = result.d[1];
                }
            },
            error: AjaxFailed
        });
    }
    else {
        document.getElementById("a5").value = "";
        document.getElementById("a6").value = "";
    }
}

