function stateChangedPostReturnXml() {
    if (xmlHttp.readyState == 4) {

        var xmlString = xmlHttp.responseText;


        var xmlDocRes = GetxDoc(xmlString);



        ////////////////////////////  Action To Return XML ////////////////////////////////////////////////////

        var action ="";

        if (xmlDocRes.firstChild == null)
            return false;

        action = xmlDocRes.firstChild.getAttribute("action");
        switch (action) {
            case "Act1":

                Back1(xmlDocRes.firstChild.childNodes[0].data);

                break;

            case "Act2":

                Back2(xmlDocRes.firstChild.childNodes[0].data);

                break;

            case "Act3":

