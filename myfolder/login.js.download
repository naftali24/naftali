                        padding: 20px;
                        margin-bottom: 15px;
                        background: #fff;
                        transition: all 0.3s ease;
                        cursor: pointer;
                        text-align: center;
                        position: relative;
                        overflow: hidden;
                    }
                    #productSelectionModal .product-card:hover {
                        border-color: #134670;
                        box-shadow: 0 2px 8px rgba(0, 124, 186, 0.15);
                    }
                    #productSelectionModal .product-card:before {
                        content: '';
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        height: 4px;
                        transform: scaleX(0);
                        transition: transform 0.3s ease;
                        background: linear-gradient(90deg, #134670, #1a5a8c);
                    }
                    
                    #productSelectionModal .product-card:hover::before {
                        transform: scaleX(1);
                    }
                    
                    #productSelectionModal .product-title {
                        font-size: 16px;
                        font-weight: bold;
                        color: #333;
                        margin-bottom: 10px;
                    }
                    #productSelectionModal .product-barcode {
                        font-size: 14px;
                        color: #134670;
                        font-weight: bold;
                        margin-bottom: 15px;
                    }
                    #productSelectionModal .product-details {
                        display: flex;
                        justify-content: space-between;
                        margin-bottom: 15px;
                    }
                    #productSelectionModal .product-detail-item {
                        text-align: center;
                    }
                    #productSelectionModal .product-detail-label {
                        font-size: 12px;
                        color: #666;
