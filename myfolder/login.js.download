                        margin-bottom: 10px;
                    }
                    #productSelectionModal .modal-subtitle {
                        color: #666;
                        font-size: 14px;
                    }
                    #productSelectionModal .close-btn {
                        position: absolute;
                        top: 15px;
                        left: 15px;
                        background: none;
                        border: none;
                        font-size: 24px;
                        color: #999;
                        cursor: pointer;
                    }
                </style>
